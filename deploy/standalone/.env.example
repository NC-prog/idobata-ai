# 井戸端AI standalone プロファイル用 .env の雛形
# cp deploy/standalone/.env.example deploy/standalone/.env して編集する。
# server/ 側（python -m src.main）も同じ変数を読む。

# ===== プロファイル =====
# standalone: ASR・LLM・TTS すべて 127.0.0.1
# site      : ASR・TTS は 127.0.0.1、LLM は IDOBATA_BACKEND_URL（Tailscale 経由の T2／3660）
IDOBATA_PROFILE=standalone
# IDOBATA_BACKEND_URL=http://t2.example.ts.net:8001/v1

# 拠点（ASR のコンテキストバイアシング用の地名リストを選ぶ）: etajima / akiota
IDOBATA_SITE=etajima

# ===== モデル・データの置き場所 =====
# /workspace を切り出したらここを /workspace/huggingface に変えるだけでよい
HF_CACHE_DIR=${HOME}/.cache/huggingface
IDOBATA_DATA_DIR=${HOME}/idobata-data
HUGGING_FACE_HUB_TOKEN=

# ===== サービング（docker compose 用） =====
ASR_MODEL=Qwen/Qwen3-ASR-1.7B
ASR_GPU_UTIL=0.30
LLM_MODEL=Qwen/Qwen3-8B-AWQ
LLM_GPU_UTIL=0.45
