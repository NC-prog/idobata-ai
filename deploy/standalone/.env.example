# 井戸端AI standalone プロファイル用 .env の雛形
# cp deploy/standalone/.env.example deploy/standalone/.env して編集する。
# server/ 側（python -m src.main）も同じ変数を読む。

# ===== プロファイル =====
# standalone: ASR・LLM・TTS すべて 127.0.0.1
# site      : ASR・TTS は 127.0.0.1、LLM は IDOBATA_BACKEND_URL（Tailscale 経由の T2／3660）
IDOBATA_PROFILE=standalone
# IDOBATA_BACKEND_URL=http://t2.example.ts.net:8001/v1

# 拠点（ASR のコンテキストバイアシング用の地名リストを選ぶ）: etajima / akiota
IDOBATA_SITE=etajima

# ===== 音声デバイス（番号か名前の一部。python -m src.main --list-devices で確認） =====
# 番号は USB 機器の抜き差しや hw:0,0 の使用状況でずれるので、名前の一部で書くのを勧める（docs/WP01_result.md A-4）。
# 7560 の当面の運用: 入力 = ALSA 直の内蔵マイク（hw:0,0、48k→16k リサンプル）、
#                    出力 = 内蔵スピーカー（alsa_output.pci-0000_00_1f.3.analog-stereo）。
# PipeWire 経由の入力（alsa_input… や既定）はフルスケールのノイズになるので使わない（docs/WP00_result.md 6-2）。
# 空にすると既定デバイス（7560 では既定デバイスへの再生が戻らないので空にしない）。CLI の --audio-device / --output-device が優先。
IDOBATA_AUDIO_INPUT_DEVICE=hw:0,0
IDOBATA_AUDIO_OUTPUT_DEVICE=alsa_output.pci-0000_00_1f.3
#
# 会議用のマイク（Avaya B109 などのスピーカーフォン）は部屋の会話まで拾い、話しかけていない人の声にも
# 応答してしまう。WP02 の声かけ機能（人を検知してから聞く）が入るまでは、入力の音量を 0.5 程度に下げる:
#   wpctl status                        # Sources の中の B109 の番号（例: 78. Avaya B109 モノ）を確認
#   wpctl set-volume <B109のsource id> 0.5
# 番号は挿し直しで変わる。sudo 不要。戻すときは 1.0。

# ===== 対話 =====
# 最後の確定発話からこの秒数で会話を区切る（履歴を消し、エッジは待機の見た目に戻る）。0 で無効
IDOBATA_IDLE_TIMEOUT_SEC=90

# ===== 同意付きの行為・職員パネル（WP04） =====
# アバターの呼び名（仮。市民公募で決める前提）
IDOBATA_AVATAR_NAME=いどちゃん
# 案内役の肩書（server/context/persona.yaml の role_title より優先。空なら persona.yaml の値＝臨時職員）
# IDOBATA_ROLE_TITLE=臨時職員
# 職員パネル（http://<窓口機>:8080/staff/、ユーザー staff）のパスワード。空なら職員パネルは無効
IDOBATA_STAFF_PASSWORD=
# 職員の PC から職員パネルを開くときは 0.0.0.0（LAN 以外からは 403）。既定は 127.0.0.1
# IDOBATA_EDGE_HTTP_HOST=0.0.0.0
# 別機のエッジ PC からつなぐとき（WP02 D、docs/edge_pc_setup.md）: WebSocket も 0.0.0.0 にし、エッジ PC の IP だけを許す
# IDOBATA_EDGE_WS_HOST=0.0.0.0
# IDOBATA_EDGE_ALLOW=192.168.50.21
# 紹介状の保存日数（起動時に古いものを消す。0 で前日以前を消す）
IDOBATA_REFERRAL_RETENTION_DAYS=30
# 「調べる」で一般のウェブ検索も使うか（既定オフ。外に出るのは検索語だけ）
IDOBATA_LOOKUP_WEB_SEARCH=0

# ===== カメラと「輪」（WP02） =====
# エッジ（ブラウザ）がカメラを撮って送り、目の前の輪（1〜3 人）とだけ話す。0 でカメラ無し（常に輪がある扱い＝従来どおり）
IDOBATA_CAMERA=1
# ブラウザが複数のカメラを見つけたとき、名前（label）にこの文字を含むものを使う（7560 の内蔵は Integrated）
IDOBATA_CAMERA_LABEL=Integrated

# ===== 会話の文字記録（WP06） =====
# 管理者ページ（http://<窓口機>:8080/admin/transcripts/、ユーザー admin）のパスワード。職員パネルとは別。空なら無効
IDOBATA_ADMIN_PASSWORD=
# 会話の文字記録の保存日数（起動時に古いものを消す。保全したセッションは残す）。音声は録音しない
IDOBATA_TRANSCRIPT_RETENTION_DAYS=7

# ===== 手続きナレッジ（WP09） =====
# 出典のページが変わって「要再確認」になった承認済みの手続きを、対話で使い続けるか（1 = 使い続けて職員パネルに印、0 = 使わない）
IDOBATA_PROCEDURE_RECHECK_USE=1

# ===== お知らせの紹介（WP11） =====
# 市町のサイトのお知らせを、来訪者の同意を取って 1 会話 1 件紹介する（1 = する、0 = しない）。記事は夜のパック更新で集める
IDOBATA_NEWS=1
# お知らせの分類・要約（夜の処理）だけに使う LLM の /v1 URL とモデル名（T2 など）。空なら会話と同じ LLM（standalone は 7560 の Qwen3-8B）
IDOBATA_NIGHT_LLM_URL=
IDOBATA_NIGHT_LLM_MODEL=

# ===== モデル・データの置き場所 =====
# /workspace を切り出したらここを /workspace/huggingface に変えるだけでよい
HF_CACHE_DIR=${HOME}/.cache/huggingface
IDOBATA_DATA_DIR=${HOME}/idobata-data
HUGGING_FACE_HUB_TOKEN=

# ===== サービング（docker compose 用） =====
ASR_MODEL=Qwen/Qwen3-ASR-1.7B
ASR_GPU_UTIL=0.35
LLM_MODEL=Qwen/Qwen3-8B-AWQ
LLM_GPU_UTIL=0.45

# VOICEVOX の合成スレッド数（docs/WP01_result.md）。7560 では 8 が最速
# VOICEVOX_CPU_THREADS=8
