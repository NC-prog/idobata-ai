# 井戸端AI 知識パックの全体の作り直し（毎週日曜 3:00。systemd の user サービス、sudo 不要）。%i は拠点
# 本文が前の版と同じチャンクはベクトルを使い回す（再埋め込みしない）
# install-kb-timers.sh が __UV__ と __REPO__ を埋めて ~/.config/systemd/user/ に置く
[Unit]
Description=idobata-ai knowledge pack full rebuild (%i)
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
WorkingDirectory=__REPO__
# GPU の予備枠を使わない（埋め込みは CPU）
Environment=CUDA_VISIBLE_DEVICES=
# 同じ拠点のビルドを重ねない（天気の更新とも重ねない）
ExecStart=/usr/bin/flock __DATA__/kb/.%i.lock __UV__ run --project kb python kb/build.py --site %i
Nice=10
